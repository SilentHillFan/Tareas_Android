<?xml version="1.0" encoding="utf-8"?>
<!--
    Indicador de carga (placeholder): fondo gris con un glifo de imagen al
    centro. Coil lo muestra mientras la imagen se descarga de internet.

    Nota: es un único <vector> porque painterResource() de Compose solo
    admite VectorDrawables o imágenes rasterizadas (no layer-list).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="36dp"
    android:height="36dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Fondo del placeholder. -->
    <path
        android:fillColor="#E0E0E0"
        android:pathData="M0,0 L24,0 L24,24 L0,24 Z" />

    <!-- Marco de la imagen (solo contorno). -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#757575"
        android:strokeWidth="1.5"
        android:pathData="M4.5,4.5 L19.5,4.5 L19.5,19.5 L4.5,19.5 Z" />

    <!-- "Sol" (círculo superior). -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#757575"
        android:strokeWidth="1.5"
        android:pathData="M8.5,9.5 m-1.5,0 a1.5,1.5 0 1 0 3,0 a1.5,1.5 0 1 0 -3,0" />

    <!-- "Montaña" del centro. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#757575"
        android:strokeWidth="1.5"
        android:pathData="M5,17 L9.5,11.5 L13,15.5 L15.5,13 L19,17" />
</vector>
