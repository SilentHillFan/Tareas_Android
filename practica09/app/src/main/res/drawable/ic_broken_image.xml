<?xml version="1.0" encoding="utf-8"?>
<!--
    Estado de error: Coil muestra este drawable cuando la URL no se puede
    descargar (imagen inexistente o sin conexión). Fondo rosa con el glifo
    de "imagen rota" (marco tachado).

    Nota: es un único <vector> porque painterResource() de Compose solo
    admite VectorDrawables o imágenes rasterizadas (no layer-list).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="36dp"
    android:height="36dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Fondo del estado de error. -->
    <path
        android:fillColor="#FFEBEE"
        android:pathData="M0,0 L24,0 L24,24 L0,24 Z" />

    <!-- Marco de la imagen (solo contorno). -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#E53935"
        android:strokeWidth="1.5"
        android:pathData="M4.5,4.5 L19.5,4.5 L19.5,19.5 L4.5,19.5 Z" />

    <!-- Tache central: imagen no disponible. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#E53935"
        android:strokeWidth="1.5"
        android:pathData="M7,7 L17,17 M17,7 L7,17" />
</vector>
